# =============================================================================
# EASM Pipeline Configuration
# =============================================================================

# --- Pipeline Mode ---
# "recon" (default) or "bounty" — bounty mode expands scanning depth
PIPELINE_MODE=recon

# --- Identity ---
USER_AGENT="EASM-Pipeline/0.1"

# --- Input ---
INPUT_SUBDOMAINS="data/input/subdomains.txt"

# --- CT-log enrichment (stage "ct", crt.sh) ---
# Opt-in. Comma-separated root domains whose Certificate Transparency history is
# queried; only names under these domains are added to the targets. Leave unset
# to skip the stage. Normally set per scan from the dashboard ("Root domains")
# or via the ROOT_DOMAINS env var, e.g.:  ROOT_DOMAINS=example.com,example.org
CT_TIMEOUT=60            # seconds per crt.sh request
CT_RETRIES=3             # crt.sh is flaky under load; retried with backoff

# --- Passive subdomain enumeration (stage "subfinder") ---
# Same opt-in as CT: runs only when ROOT_DOMAINS is set; only names under those
# domains are kept. crt.sh is excluded (the ct stage owns it). API keys go in
# config/subfinder-provider-config.yaml (see the .example file; gitignored).
SUBFINDER_THREADS=10
SUBFINDER_TIMEOUT=30         # seconds per source request
SUBFINDER_MAX_TIME=10        # minutes per root domain
SUBFINDER_TOTAL_TIMEOUT=900  # hard stage cap (seconds)
SUBFINDER_ALL=false          # true = query every source (slow, more results)

CMDB_EXPORT="data/input/cmdb_export.csv"

# --- Output directories ---
OUTPUT_DIR="data/output"
SCREENSHOT_DIR="data/screenshots"
CACHE_DIR="data/cache"
LOG_DIR="logs"

# --- DNS (dnsx) ---
DNS_RATE_LIMIT=500
DNS_RETRIES=2
DNS_RECORD_TYPES="a,aaaa,cname,ns,mx,txt"

# --- Port Scanning (naabu) ---
NAABU_TOP_PORTS=100
NAABU_PORTS=
NAABU_RATE=200
NAABU_WORKERS=25
NAABU_RETRIES=1
NAABU_EXCLUDE_CDN=true

# --- CDN / Cloud / WAF classification (stage "cdn", cdncheck) ---
# Matches live hosts against cdncheck's provider IP ranges; feeds the CDN
# detector and WAF verdicts in normalize.
CDNCHECK_THREADS=50

# --- HTTP Probing (httpx) ---
HTTPX_THREADS=20
HTTPX_RATE_LIMIT=20
HTTPX_TIMEOUT=10
HTTPX_RETRIES=2
HTTPX_MAX_HOST_ERROR=30
HTTPX_SCREENSHOTS=true

# --- WAF detection (stage "waf", waf-detector) ---
# Passive fingerprinting only — no attack payloads are sent. Runs against one
# URL per HTTP origin found by httpx.
WAF_MAX_TARGETS=2000     # cap on origins scanned
WAF_BATCH_SIZE=25        # origins per waf-detect invocation
WAF_WORKERS=4            # parallel waf-detect invocations
WAF_BATCH_TIMEOUT=300    # seconds per batch

# --- Tenable scan-scope routing (stage "scope", recon mode) ---
# Routes assets to Tenable VM (unique IPs) / WAS (URLs) — see TENABLE_SCOPE_PIPELINE.MD.
# detect_cdn scores 0.35 per independent signal, so 0.35 = exclude any CDN hit.
TENABLE_CDN_MIN_CONFIDENCE=0.35
TENABLE_WAF_MIN_CONFIDENCE=0.5   # cdncheck IP-range-only verdicts score 0.6
TENABLE_OWNED_CIDRS=""           # e.g. "203.0.113.0/24,198.51.100.10" — overrides CDN/3rd-party/PaaS heuristics
TENABLE_OWNED_ASNS=""            # e.g. "AS64500,64501"
TENABLE_VM_REQUIRE_OWNED=false   # true = VM IPs outside owned ranges go to tenable_vm_review.txt
TENABLE_SCOPE_CMDB_ONLY=false    # true = only CMDB-registered assets enter scan scope
TENABLE_WAS_INCLUDE_SAAS=false   # true = DAST vendor SaaS apps too (Shopify, Zendesk, ...) — check vendor terms

# --- TLS (tlsx) ---
TLSX_CONCURRENCY=25
TLSX_SCAN_MODE="auto"

# --- zgrab2 ---
ZGRAB_SENDERS=100
ZGRAB_TIMEOUT=10

# --- Nuclei ---
NUCLEI_RATE_LIMIT=20
NUCLEI_BULK_SIZE=25
NUCLEI_CONCURRENCY=20
NUCLEI_TIMEOUT=10
NUCLEI_RETRIES=1
NUCLEI_TAGS="technologies,exposures,misconfiguration,default-logins,exposed-panels"
NUCLEI_EXCLUDE_TAGS="intrusive,dos,fuzz,takeover"
NUCLEI_SEVERITIES="info,low,medium,high,critical"

# --- DuckDB ---
DUCKDB_PATH="data/output/easm.duckdb"

# --- Cache TTL (seconds) ---
CACHE_TTL=86400

# --- Web ports for HTTP probing ---
WEB_PORTS="80,443,8080,8443,8444,9443"

# --- TLS ports for deep TLS grab ---
TLS_PORTS="443,8443,8444,9443"

# --- Nerva (replaces zgrab2 as primary fingerprinting engine) ---
# NERVA_TIMEOUT is in seconds; run_nerva.sh converts to ms for nerva -w flag.
NERVA_TIMEOUT=3
NERVA_THREADS=50
NERVA_FAST_MODE=true
NERVA_UDP=false
NERVA_VERBOSE=false
NERVA_MISCONFIGS=true    # enable --misconfigs to surface unauth APIs, weak SSH, etc.

# --- Fingerprinting backend ---
# Set to "zgrab2" to fall back to zgrab2; set ZGRAB2_FALLBACK=true to run both.
FINGERPRINT_BACKEND=nerva
ZGRAB2_FALLBACK=false

# --- Legacy zgrab2 (deprecated — kept for optional fallback only) ---
# ZGRAB_SENDERS=100
# To use zgrab2 as fallback: FINGERPRINT_BACKEND=zgrab2
# To use zgrab2 alongside nerva for deep handshakes: ZGRAB2_FALLBACK=true

# --- Debug / Performance monitoring ---
DEBUG_MODE=false

# --- Livecheck mode (CMDB scope governance) ---
LIVECHECK_DEADLINE_DAYS=30
LIVECHECK_CNAME_DEPTH_THRESHOLD=3

# --- Service Detection Fallback ---
# When httpx fails to probe a port, run naabu -sV for service identification.
SERVICE_DETECT_FALLBACK=true
SERVICE_DETECT_RATE=100
